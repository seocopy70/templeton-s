# 템플턴S · 환경변수 예시
# 이 파일을 복사하여 .env 로 만들고 실제 값을 입력하세요.
# .env 는 git에 커밋하지 마세요.

KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ENV=paper          # paper | real
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT=01

# 선택
POLL_INTERVAL_SEC=10
LOG_LEVEL=INFO

# AI 해석 (선택) — 없으면 규칙 기반 폴백
GROQ_API_KEY=

# Phase 4 — 공시 (선택) https://opendart.fss.or.kr
DART_API_KEY=
NEWS_ENABLED=false
